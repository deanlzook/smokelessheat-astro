---
// Shared layout for every product page (rendered from the `products` collection).
import { getEntries } from 'astro:content';
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCategory } from '../lib/categories';
import { formatPrice, productUrl, type Product } from '../lib/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const d = product.data;
const category = getCategory(d.category)!;
const [hero, ...gallery] = d.images;
const heading = d.heading ?? d.title;
const price = formatPrice(d.price);
const compareAt = formatPrice(d.compareAtPrice);
const related = d.related.length ? await getEntries(d.related) : [];

const singleVideos = d.videos.filter((v) => v.layout === 'single' || (!v.layout && d.videos.length === 1));
const gridVideos = d.videos.filter((v) => !singleVideos.includes(v));
const iframeAllow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
const specGroups = [...new Set(d.specs.map((s) => s.group ?? ''))];
---

<Layout title={d.seoTitle ?? `${d.title} | Smokeless Heat`} description={d.seoDescription}>
  <Header />
  <main class="pt-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 py-4 text-sm text-charcoal/60">
      <a href="/" class="hover:text-ember">Home</a> / <a href="/products" class="hover:text-ember">Products</a> / <a href={`/products/${category.slug}`} class="hover:text-ember">{category.title}</a> / <span>{d.title}</span>
    </div>

    <section class="max-w-6xl mx-auto px-6 py-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <img src={hero.src} alt={hero.alt ?? d.title} class="w-full max-w-sm border border-wood/10" />
        <div>
          {d.series && <p class="text-sm text-ember mb-2">{d.series}</p>}
          <h1 class="font-serif text-3xl md:text-4xl text-darkwood">{heading}</h1>
          {price && (
            <div class="mt-4 flex items-baseline gap-3">
              {compareAt && <span class="text-lg text-charcoal/40 line-through">{compareAt}</span>}
              <span class="text-2xl font-medium text-darkwood">{price}</span>
            </div>
          )}
          <p class="mt-2 text-charcoal/70">{d.shortDescription}</p>
          <a href={d.cta.href} class="inline-block mt-6 bg-ember text-cream px-6 py-3 text-sm uppercase tracking-wide font-medium hover:bg-wood transition">{d.cta.label}</a>
          {d.stockNote && <p class="mt-3 text-sm text-ember">{d.stockNote}</p>}
          {(d.sku || d.categoriesLabel || d.stockLabel) && (
            <div class="mt-6 pt-6 border-t border-wood/10 text-sm text-charcoal/70">
              {d.sku && <span class="mr-6"><strong>SKU:</strong> {d.sku}</span>}
              {d.categoriesLabel && <span class="mr-6"><strong>Categories:</strong> {d.categoriesLabel}</span>}
              {d.stockLabel && <span class="text-ember">{d.stockLabel}</span>}
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-12 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-6">Description</h2>
      <div class="space-y-4 text-charcoal/90 leading-relaxed [&>h3]:font-serif [&>h3]:text-xl [&>h3]:text-darkwood [&>h4]:font-serif [&>h4]:text-lg [&>h4]:text-darkwood [&>ul]:list-disc [&>ul]:list-inside [&>ul]:space-y-1 [&>ol]:list-decimal [&>ol]:list-inside [&>ol]:space-y-1 [&_a]:text-ember [&_a:hover]:underline">
        <slot />
      </div>

      {gallery.map((img) => (
        <>
          <img src={img.src} alt={img.alt ?? d.title} class="mt-8 w-full border border-wood/10" />
          {img.caption && <p class="text-sm text-wood mt-2">{img.caption}</p>}
        </>
      ))}

      {!d.videosTitle && singleVideos.map((v) => (
        <div class="mt-8">
          <iframe class="w-full max-w-lg aspect-video" src={v.src} title={v.title ?? `${d.title} video`} frameborder="0" allow={iframeAllow} allowfullscreen></iframe>
        </div>
      ))}
      {!d.videosTitle && gridVideos.length > 0 && (
        <div class="mt-8 grid md:grid-cols-2 gap-6">
          {gridVideos.map((v) => (
            <div>
              {v.caption && <h5 class="font-medium mb-2">{v.caption}</h5>}
              <iframe class="w-full aspect-video" src={v.src} title={v.title ?? `${d.title} video`} frameborder="0" allow={iframeAllow} allowfullscreen></iframe>
            </div>
          ))}
        </div>
      )}
    </section>

    {d.videosTitle && d.videos.length > 0 && (
      <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
        <h2 class="font-serif text-2xl text-darkwood mb-4">{d.videosTitle}</h2>
        <div class="space-y-6">
          {d.videos.map((v) => (
            <div>
              {v.caption && <h5 class="font-medium mb-2">{v.caption}</h5>}
              <iframe class="w-full max-w-lg aspect-video" src={v.src} title={v.title ?? `${d.title} video`} frameborder="0" allow={iframeAllow} allowfullscreen></iframe>
            </div>
          ))}
        </div>
      </section>
    )}

    {d.specs.length > 0 && (
      <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
        <h2 class="font-serif text-2xl text-darkwood mb-4">Specifications</h2>
        {specGroups.map((group) => (
          <div class="mb-6">
            {group && <h3 class="font-serif text-lg text-darkwood mb-2">{group}</h3>}
            <table class="w-full text-sm">
              <tbody>
                {d.specs.filter((s) => (s.group ?? '') === group).map((s) => (
                  <tr class="border-b border-wood/10">
                    <th class="py-2 pr-6 text-left font-medium text-charcoal/80 w-1/3">{s.label}</th>
                    <td class="py-2 text-charcoal/90">{s.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </section>
    )}

    {d.manuals.length > 0 && (
      <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
        <h2 class="font-serif text-2xl text-darkwood mb-4">Downloads</h2>
        <div class="space-y-2">
          {d.manuals.map((m) => (
            <a href={m.href} target="_blank" rel="noopener noreferrer" class="block text-ember hover:underline">{m.title}</a>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
        <h2 class="font-serif text-2xl text-darkwood mb-4">Related Products</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {related.map((r) => (
            <a href={productUrl(r)} class="flex bg-cream border border-wood/10 hover:border-ember transition overflow-hidden">
              <img src={r.data.images[0].src} alt={r.data.images[0].alt ?? r.data.title} class="w-20 h-20 object-contain flex-shrink-0" />
              <div class="p-4">
                <p class="font-serif text-lg text-darkwood">{r.data.heading ?? r.data.title}</p>
                <p class="text-xs text-charcoal/70">{r.data.shortDescription}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {d.footnote && (
      <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10"><p class="text-sm text-charcoal/60">{d.footnote}</p></section>
    )}
  </main>
  <Footer />
</Layout>
