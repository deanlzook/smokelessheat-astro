---
const nav = [
  { href: "/", label: "Home" },
  { href: "/products", label: "Products" },
  { href: "/how-it-works", label: "How It Works" },
  { href: "/blog", label: "Blog" },
  { href: "/links", label: "Links" },
  { href: "/contact", label: "Contact" },
];
---

<header class="fixed top-0 w-full z-50 bg-cream/95 backdrop-blur-sm border-b border-wood/10">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-serif text-xl md:text-2xl tracking-tight text-darkwood">Smokeless Heat</a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex gap-8">
      {nav.map(item => (
        <a href={item.href} class="text-sm font-medium tracking-wide uppercase text-charcoal/80 hover:text-ember transition">{item.label}</a>
      ))}
    </nav>

    <!-- Desktop search -->
    <div class="relative hidden md:block" id="search-container">
      <input 
        id="header-search" 
        type="text" 
        placeholder="Search..." 
        autocomplete="off"
        class="border border-wood/20 px-3 py-1.5 text-sm w-48 focus:outline-none focus:border-ember" 
      />
      <div id="search-dropdown" class="absolute top-full right-0 mt-1 w-72 bg-white border border-wood/20 shadow-lg hidden z-50 max-h-96 overflow-y-auto"></div>
    </div>

    <!-- Mobile hamburger -->
    <button id="mobile-menu-btn" class="md:hidden p-2 text-darkwood" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="md:hidden hidden bg-cream border-t border-wood/10">
    <nav class="px-6 py-4 space-y-3">
      {nav.map(item => (
        <a href={item.href} class="block text-base font-medium tracking-wide uppercase text-charcoal/90 hover:text-ember py-2">{item.label}</a>
      ))}
    </nav>
    <div class="px-6 pb-4">
      <input 
        id="mobile-search" 
        type="text" 
        placeholder="Search..." 
        autocomplete="off"
        class="w-full border border-wood/20 px-3 py-2 text-sm focus:outline-none focus:border-ember" 
      />
      <div id="mobile-search-dropdown" class="mt-1 bg-white border border-wood/20 shadow-lg hidden max-h-64 overflow-y-auto"></div>
    </div>
  </div>
</header>

<script>
  import { search, highlight, escapeHtml, type SearchItem } from '../lib/search';

  let indexPromise: Promise<SearchItem[]> | null = null;
  let indexError = false;

  function loadIndex(): Promise<SearchItem[]> {
    if (!indexPromise) {
      indexPromise = fetch('/search-index.json')
        .then((res) => {
          if (!res.ok) throw new Error('Failed to load search index');
          return res.json();
        })
        .catch((err) => {
          indexError = true;
          indexPromise = null;
          throw err;
        });
    }
    return indexPromise;
  }

  // Warm the index as soon as the header script runs.
  loadIndex().catch(() => {});

  function dropdownHtml(query: string, items: SearchItem[]): string {
    const hits = search(items, query);
    const words = query.toLowerCase().match(/[a-z0-9]+(?:\.[0-9]+)*/g) ?? [];
    const shown = hits.slice(0, 8);
    if (indexError) {
      return '<div class="px-4 py-3 text-sm text-charcoal/60">Search is unavailable</div>';
    }
    if (shown.length === 0) {
      return '<div class="px-4 py-3 text-sm text-charcoal/60">No results</div>';
    }
    const list = shown.map((hit) => `
      <a href="${escapeHtml(hit.item.href)}" class="block px-4 py-2.5 hover:bg-cream border-b border-wood/10 last:border-0">
        <span class="text-xs text-ember">${escapeHtml(hit.item.type)}</span>
        <div class="font-medium text-darkwood text-sm leading-tight">${highlight(hit.item.title, words)}</div>
      </a>
    `).join('');
    const more = hits.length > 8
      ? `<a href="/search?q=${encodeURIComponent(query)}" class="block px-4 py-2.5 text-sm text-ember hover:bg-cream">See all ${hits.length} results</a>`
      : '';
    return list + more;
  }

  function wireSearch(input: HTMLInputElement | null, dropdown: HTMLElement | null) {
    if (!input || !dropdown) return;

    async function show(q: string) {
      const query = q.trim();
      if (!query) {
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        return;
      }
      if (!indexPromise && !indexError) loadIndex().catch(() => {});
      try {
        const items = await loadIndex();
        if (input.value.trim() !== query) return; // stale
        dropdown.innerHTML = dropdownHtml(query, items);
        dropdown.classList.remove('hidden');
      } catch {
        dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-charcoal/60">Search is unavailable</div>';
        dropdown.classList.remove('hidden');
      }
    }

    input.addEventListener('input', (e) => show((e.target as HTMLInputElement).value));
    input.addEventListener('focus', () => { if (input.value) show(input.value); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        window.location.href = '/search?q=' + encodeURIComponent(input.value.trim());
      }
    });
  }

  const desktopInput = document.getElementById('header-search') as HTMLInputElement | null;
  const desktopDropdown = document.getElementById('search-dropdown');
  wireSearch(desktopInput, desktopDropdown);

  document.addEventListener('click', (e) => {
    const container = document.getElementById('search-container');
    if (container && desktopDropdown && !container.contains(e.target as Node)) {
      desktopDropdown.classList.add('hidden');
    }
  });

  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  const mobileInput = document.getElementById('mobile-search') as HTMLInputElement | null;
  const mobileDropdown = document.getElementById('mobile-search-dropdown');
  wireSearch(mobileInput, mobileDropdown);
</script>
