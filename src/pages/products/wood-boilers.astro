---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Wood Boilers | Smokeless Heat">
  <Header />
  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Products</p>
        <h1 class="font-serif text-4xl md:text-5xl">Wood Boilers</h1>
      </div>
    </section>
    <section class="py-16 bg-cream">
      <div class="max-w-4xl mx-auto px-6 space-y-4">
        <a href="/products/wood-boilers/vedolux-lambda-350" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Vedolux-Lambda-350-1.jpg" alt="Vedolux Lambda 350" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Vedolux Lambda</p>
            <h2 class="font-serif text-xl text-darkwood">Vedolux Lambda 350</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Wood gasification boiler with lambda control. ~35 kW / 120 kBTU.</p>
          </div>
        </a>
        <a href="/products/wood-boilers/vedolux-lambda-450" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Vedolux-Lambda-450.jpg" alt="Vedolux Lambda 450" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Vedolux Lambda</p>
            <h2 class="font-serif text-xl text-darkwood">Vedolux Lambda 450</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Wood gasification boiler with lambda control. ~45 kW / 154 kBTU.</p>
          </div>
        </a>
        <a href="/products/wood-boilers/vedolux-lambda-650" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Vedolux-Lambda1.jpg" alt="Vedolux Lambda 650" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Vedolux Lambda</p>
            <h2 class="font-serif text-xl text-darkwood">Vedolux Lambda 650</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Wood gasification boiler with lambda control. ~65 kW / 220 kBTU.</p>
          </div>
        </a>
        <a href="/products/wood-boilers/vedolux-55" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Vedolux-55-1.jpg" alt="Vedolux 55" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Vedolux Fan Draft</p>
            <h2 class="font-serif text-xl text-darkwood">Vedolux 55</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Wood gasification boiler with induction draft fan.. ~55 kW / 190 kBTU.</p>
          </div>
        </a>
        <a href="/products/wood-boilers/vedolux-37" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Vedolux-55.jpg" alt="Vedolux 37" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Vedolux Fan Draft</p>
            <h2 class="font-serif text-xl text-darkwood">Vedolux 37</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Wood gasification boiler with suction fan. ~37 kW / 126 kBTU.</p>
          </div>
        </a>
        <a href="/products/wood-boilers/vedolux-30" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Vedolux-301.jpg" alt="Vedolux 30" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Vedolux Fan Draft</p>
            <h2 class="font-serif text-xl text-darkwood">Vedolux 30</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Wood gasification boiler with integrated fan. ~30 kW / 102 kBTU.</p>
          </div>
        </a>
        <a href="/products/wood-boilers/vedolux-40-ub" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Vedolux-40-UB.jpg" alt="Vedolux 40 UB" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Vedolux Natural Draft</p>
            <h2 class="font-serif text-xl text-darkwood">Vedolux 40 UB</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Wood gasification boiler with natural draft. Legacy – not stocked.</p>
          </div>
        </a>
        <a href="/products/wood-boilers/vedolux-50-ub" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Vedolux-50-UB.jpg" alt="Vedolux 50 UB" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Vedolux Natural Draft</p>
            <h2 class="font-serif text-xl text-darkwood">Vedolux 50 UB</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Wood gasification boiler with natural draft. Legacy – not stocked.</p>
          </div>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
