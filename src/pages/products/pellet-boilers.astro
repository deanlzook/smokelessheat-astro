---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Pellet Boilers | Smokeless Heat">
  <Header />
  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Products</p>
        <h1 class="font-serif text-4xl md:text-5xl">Pellet Boilers</h1>
      </div>
    </section>
    <section class="py-16 bg-cream">
      <div class="max-w-4xl mx-auto px-6 space-y-4">
        <a href="/products/pellet-boilers/pellmax-ub" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Pellmax-UB.jpg" alt="Pellmax UB" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Pellmax</p>
            <h2 class="font-serif text-xl text-darkwood">Pellmax UB</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Pellet boiler with integrated burner.</p>
          </div>
        </a>
        <a href="/products/pellet-boilers/viking-bio-200" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Viking-Bio-200.jpg" alt="Viking Bio 200" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Viking Bio</p>
            <h2 class="font-serif text-xl text-darkwood">Viking Bio 200</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Self-cleaning pellet burner. Legacy – out of stock.</p>
          </div>
        </a>
        <a href="/products/pellet-boilers/pellet-store-200" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Pellet-Store-200.jpg" alt="Pellet Store 200" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Pellet Storage</p>
            <h2 class="font-serif text-xl text-darkwood">Pellet Store 200</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Pellet storage unit. Out of stock.</p>
          </div>
        </a>
        <a href="/products/pellet-boilers/viking-bio-35" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Viking-Bio-35-Pellet-Burner.jpg" alt="Viking Bio 35" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Viking Bio</p>
            <h2 class="font-serif text-xl text-darkwood">Viking Bio 35</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Pellet burner. $3,231.00</p>
          </div>
        </a>
        <a href="/products/pellet-boilers/viking-bio-20" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Viking-Bio-20-Pellet-Burner1.jpg" alt="Viking Bio 20" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Viking Bio</p>
            <h2 class="font-serif text-xl text-darkwood">Viking Bio 20</h2>
            <p class="mt-1 text-charcoal/70 text-sm">Pellet burner. $1,919.00</p>
          </div>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
