---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<Layout title="9 kW Immersion Heater | Smokeless Heat" description="9 kW electric immersion heater for Teknik and Aqualux CU accumulator tanks. Provides backup or supplemental heat.">
  <Header />

  <main class="pt-24 bg-white">
    <!-- Breadcrumb -->
    <div class="max-w-6xl mx-auto px-6 py-4 text-sm text-charcoal/60">
      <a href="/" class="hover:text-ember">Home</a> / 
      <a href="/products" class="hover:text-ember">Products</a> / 
      <a href="/products/heating-accessories" class="hover:text-ember">Heating Accessories</a> / 
      <span class="text-charcoal">9 kW Immersion Heater</span>
    </div>

    <!-- Product Header: Image left, details right -->
    <section class="max-w-6xl mx-auto px-6 py-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <!-- Left: Main image -->
        <div>
          <img src="/images/electric-element-1.jpg" alt="9 kW Immersion Heater" class="w-full max-w-md border border-wood/10" />
        </div>

        <!-- Right: Title, price, short description, call to order -->
        <div>
          <p class="text-sm text-ember mb-2">Electric Heating, Heating Accessories</p>
          <h1 class="font-serif text-3xl md:text-4xl text-darkwood">9 kW Immersion Heater</h1>
          
          <div class="mt-4 flex items-baseline gap-3">
            <span class="text-lg text-charcoal/40 line-through">$444.00</span>
            <span class="text-2xl font-medium text-darkwood">$399.00</span>
          </div>
          
          <p class="mt-2 text-charcoal/70">4.5 kW Electric Immersion Element</p>

          <a href="tel:8553890083" class="inline-block mt-6 bg-ember text-cream px-6 py-3 text-sm uppercase tracking-wide font-medium hover:bg-wood transition">
            Call to Order: 855-389-0083
          </a>

          <div class="mt-6 pt-6 border-t border-wood/10 text-sm text-charcoal/70">
            <span class="mr-6"><strong>SKU:</strong> 6273</span>
            <span><strong>Categories:</strong> Electric Heating, Heating Accessories</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Full Description -->
    <section class="max-w-4xl mx-auto px-6 py-12 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-6">Description</h2>
      
      <div class="space-y-4 text-charcoal/90 leading-relaxed">
        <p><strong>9 kW Electric Immersion Heater</strong></p>
        <p>These immersion heaters fit Teknik and Aqualux CU accumulator tanks, and are often used to supplement or provide backup or freeze protection to wood and pellet-firing systems. The element can be added to other accumulator tanks outfitted with an appropriate 2″ threaded port.</p>
        <p>The 9 kW element offers 30.7 kBTU heating capacity.</p>
      </div>

      <img src="/images/9kw-element-installed.png" alt="Element installed into Aqualux CU 750 accumulator tank" class="mt-8 w-full border border-wood/10" />
      <p class="text-sm text-wood mt-2">Element installed into Aqualux CU 750 accumulator tank (left tank)</p>
    </section>

    <!-- Downloads -->
    <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-4">Downloads</h2>
      <p class="text-charcoal/70">Manuals and technical documents will be added as they become available.</p>
    </section>

    <!-- Footer note -->
    <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
      <p class="text-sm text-charcoal/60">Legacy product. Contact Smokeless Heat for availability or technical support on existing systems.</p>
    </section>
  </main>

  <Footer />
</Layout>