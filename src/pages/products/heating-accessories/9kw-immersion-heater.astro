---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<Layout title="9 kW Immersion Heater | Smokeless Heat" description="9 kW electric immersion heater for Teknik and Aqualux CU accumulator tanks. Provides backup or supplemental heat.">
  <Header />

  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Heating Accessories</p>
        <h1 class="font-serif text-4xl md:text-5xl">9 kW Immersion Heater</h1>
        <p class="mt-4 text-cream/70">Electric backup and supplemental heating element for thermal storage tanks.</p>
      </div>
    </section>

    <section class="py-16 bg-cream">
      <div class="max-w-4xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-10">
          <div>
            <img src="/images/Maine-aqualux-with-9kw-element-300x199-1.png" alt="9 kW immersion heater installed on Aqualux CU tank" class="w-full border border-wood/20" />
            <p class="text-sm text-wood mt-2">Element installed into Aqualux CU 750 accumulator tank</p>
          </div>
          <div class="space-y-6 text-charcoal/90 leading-relaxed">
            <div>
              <h2 class="font-serif text-2xl text-darkwood mb-3">Description</h2>
              <p>These immersion heaters fit Teknik and Aqualux CU accumulator tanks, and are often used to supplement or provide backup or freeze protection to wood and pellet-firing systems.</p>
              <p class="mt-3">The element can be added to other accumulator tanks outfitted with an appropriate 2″ threaded port.</p>
              <p class="mt-3">The 9 kW element offers 30.7 kBTU heating capacity.</p>
            </div>
            <div>
              <h2 class="font-serif text-2xl text-darkwood mb-3">Details</h2>
              <ul class="space-y-1 text-sm">
                <li><strong>SKU:</strong> 6273</li>
                <li><strong>Power:</strong> 9 kW</li>
                <li><strong>Capacity:</strong> ~30.7 kBTU</li>
                <li><strong>Compatibility:</strong> Teknik and Aqualux CU tanks; other tanks with 2″ threaded port</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-wood/20">
          <h2 class="font-serif text-2xl text-darkwood mb-4">Downloads</h2>
          <p class="text-charcoal/70">Manuals and technical documents will be added as they become available.</p>
        </div>

        <div class="mt-10 pt-6 border-t border-wood/20">
          <p class="text-sm text-charcoal/60">Legacy product. Contact Smokeless Heat for availability or technical support on existing systems.</p>
          <a href="/contact" class="inline-block mt-4 bg-ember text-cream px-6 py-3 text-sm uppercase tracking-widest hover:bg-wood transition">Contact Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
