---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<Layout title="9 kW Immersion Heater | Smokeless Heat" description="9 kW electric immersion heater for Teknik and Aqualux CU accumulator tanks. Provides backup or supplemental heat.">
  <Header />

  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Heating Accessories</p>
        <h1 class="font-serif text-4xl md:text-5xl">9 kW Immersion Heater</h1>
        <p class="mt-4 text-cream/70">Electric backup and supplemental heating element for thermal storage tanks.</p>
      </div>
    </section>

    <section class="py-16 bg-cream">
      <div class="max-w-4xl mx-auto px-6 space-y-8 text-charcoal/90 leading-relaxed">
        <img src="/images/Maine-aqualux-with-9kw-element-300x199-1.png" alt="9 kW immersion heater installed on Aqualux tank" class="w-full max-w-md border border-wood/20" />

        <div>
          <h2 class="font-serif text-2xl text-darkwood mb-4">Description</h2>
          <p>These immersion heaters fit Teknik and Aqualux CU accumulator tanks and are often used to supplement or provide backup or freeze protection to wood and pellet-firing systems.</p>
          <p class="mt-4">The element can be added to other accumulator tanks outfitted with an appropriate 2″ threaded port.</p>
          <p class="mt-4">The 9 kW element offers approximately 30.7 kBTU of heating capacity.</p>
        </div>

        <div>
          <h2 class="font-serif text-2xl text-darkwood mb-4">Details</h2>
          <ul class="list-disc list-inside space-y-2">
            <li><strong>SKU:</strong> 6273</li>
            <li><strong>Power:</strong> 9 kW (typically configured as dual 4.5 kW elements)</li>
            <li><strong>Application:</strong> Backup heat, supplemental heat, or freeze protection in thermal storage tanks</li>
            <li><strong>Compatibility:</strong> Teknik and Aqualux CU tanks; other tanks with suitable 2″ threaded port</li>
          </ul>
        </div>

        <div>
          <h2 class="font-serif text-2xl text-darkwood mb-4">Downloads</h2>
          <p class="text-charcoal/70">Manuals and technical documents for this product will be added here as they are collected.</p>
        </div>

        <div class="pt-6 border-t border-wood/20">
          <p class="text-sm text-charcoal/60">This is a legacy product. Contact Smokeless Heat for availability or technical support on existing systems.</p>
          <a href="/contact" class="inline-block mt-4 bg-ember text-cream px-6 py-3 text-sm uppercase tracking-widest hover:bg-wood transition">Contact Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>