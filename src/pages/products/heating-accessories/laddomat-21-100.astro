---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<Layout title="Laddomat 21-100 | Smokeless Heat" description="Laddomat 21-100 loading unit with insulation for wood boiler thermal storage systems.">
  <Header />

  <main class="pt-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 py-4 text-sm text-charcoal/60">
      <a href="/" class="hover:text-ember">Home</a> / 
      <a href="/products" class="hover:text-ember">Products</a> / 
      <a href="/products/heating-accessories" class="hover:text-ember">Heating Accessories</a> / 
      <span class="text-charcoal">Laddomat 21-100</span>
    </div>

    <section class="max-w-6xl mx-auto px-6 py-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <img src="/images/laddomat-21-100.png" alt="Laddomat 21-100 with insulation" class="w-full max-w-sm border border-wood/10" />
        </div>
        <div>
          <p class="text-sm text-ember mb-2">Heating Accessories</p>
          <h1 class="font-serif text-3xl md:text-4xl text-darkwood">Laddomat 21-100</h1>
          
          <div class="mt-4">
            <span class="text-2xl font-medium text-darkwood">Call for pricing</span>
          </div>
          
          <p class="mt-2 text-charcoal/70">Loading unit with insulation for efficient charging of thermal storage tanks.</p>

          <a href="tel:8553890083" class="inline-block mt-6 bg-ember text-cream px-6 py-3 text-sm uppercase tracking-wide font-medium hover:bg-wood transition">
            Call to Order: 855-389-0083
          </a>

          <div class="mt-6 pt-6 border-t border-wood/10 text-sm text-charcoal/70">
            <span><strong>Categories:</strong> Heating Accessories</span>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-12 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-6">Description</h2>
      <div class="space-y-4 text-charcoal/90 leading-relaxed">
        <p>The Laddomat 21-100 is a loading unit designed for wood-fired boiler systems with thermal storage. It controls the flow between the boiler and the accumulator tank to maintain proper boiler temperature and efficient heat transfer.</p>
        <p>Includes insulation jacket. Suitable for use with Vedolux boilers and Aqualux / Teknik storage tanks.</p>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-4">Downloads</h2>
      <div class="space-y-2">
        <a href="/images/Laddomat_manual.pdf" target="_blank" rel="noopener noreferrer" class="block text-ember hover:underline">
          Laddomat Manual (PDF)
        </a>
        <a href="/images/Why_Laddomat.pdf" target="_blank" rel="noopener noreferrer" class="block text-ember hover:underline">
          Why Laddomat (PDF)
        </a>
      </div>
    </section>

    <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
      <p class="text-sm text-charcoal/60">Legacy product. Contact Smokeless Heat for availability or technical support on existing systems.</p>
    </section>
  </main>

  <Footer />
</Layout>
