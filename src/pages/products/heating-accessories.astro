---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Heating Accessories | Smokeless Heat">
  <Header />
  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Products</p>
        <h1 class="font-serif text-4xl md:text-5xl">Heating Accessories</h1>
      </div>
    </section>
    <section class="py-16 bg-cream">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-charcoal/70">Heating accessories, controls, and system components will be listed here.</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
