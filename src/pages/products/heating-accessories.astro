---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Heating Accessories | Smokeless Heat">
  <Header />
  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Products</p>
        <h1 class="font-serif text-4xl md:text-5xl">Heating Accessories</h1>
      </div>
    </section>
    <section class="py-16 bg-cream">
      <div class="max-w-4xl mx-auto px-6 space-y-4">
        <a href="/products/heating-accessories/9kw-immersion-heater" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/electric-element-1.jpg" alt="9 kW Immersion Heater" class="w-32 h-32 object-cover flex-shrink-0" />
          <div class="p-6">
            <h2 class="font-serif text-xl text-darkwood">9 kW Immersion Heater</h2>
            <p class="mt-2 text-charcoal/70 text-sm">Electric backup element for Teknik and Aqualux CU tanks. 30.7 kBTU capacity.</p>
          </div>
        </a>
        <a href="/products/heating-accessories/4.5kw-immersion-heater" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/electric-element-1.jpg" alt="4.5 kW Immersion Heater" class="w-32 h-32 object-cover flex-shrink-0" />
          <div class="p-6">
            <h2 class="font-serif text-xl text-darkwood">4.5 kW Immersion Heater</h2>
            <p class="mt-2 text-charcoal/70 text-sm">Electric backup element for Teknik and Aqualux CU tanks. ~15.4 kBTU capacity.</p>
          </div>
        </a>
        <a href="/products/heating-accessories/lk-810-loading-unit" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/lk-810-loading-unit.jpg" alt="LK 810 Loading Unit" class="w-32 h-32 object-cover flex-shrink-0" />
          <div class="p-6">
            <h2 class="font-serif text-xl text-darkwood">LK 810 Loading Unit</h2>
            <p class="mt-2 text-charcoal/70 text-sm">Compact loading unit for solid fuel boiler and thermal storage systems.</p>
          </div>
        </a>
        <a href="/products/heating-accessories/laddomat-21-100" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/laddomat-21-100.png" alt="Laddomat 21-100" class="w-32 h-32 object-cover flex-shrink-0" />
          <div class="p-6">
            <h2 class="font-serif text-xl text-darkwood">Laddomat 21-100</h2>
            <p class="mt-2 text-charcoal/70 text-sm">Loading unit with insulation for efficient charging of thermal storage tanks.</p>
          </div>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>