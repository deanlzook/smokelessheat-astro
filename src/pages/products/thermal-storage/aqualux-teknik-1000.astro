---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---
<Layout title="Aqualux Teknik 1000 | Smokeless Heat">
  <Header />
  <main class="pt-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 py-4 text-sm text-charcoal/60">
      <a href="/" class="hover:text-ember">Home</a> / <a href="/products" class="hover:text-ember">Products</a> / <a href="/products/thermal-storage" class="hover:text-ember">Thermal Storage</a> / <span>Aqualux Teknik 1000</span>
    </div>
    <section class="max-w-6xl mx-auto px-6 py-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <img src="/images/products/Aqualux-Teknik-750.jpg" alt="Aqualux Teknik 1000" class="w-full max-w-sm border border-wood/10" />
        <div>
          <p class="text-sm text-ember mb-2">Aqualux Teknik Tanks</p>
          <h1 class="font-serif text-3xl md:text-4xl text-darkwood">Aqualux Teknik 1000-discontinued</h1>
          <div class="mt-4 flex items-baseline gap-3">
            <span class="text-lg text-charcoal/40 line-through">$6,521.00</span>
            <span class="text-2xl font-medium text-darkwood">$5,313.00</span>
          </div>
          <p class="mt-2 text-charcoal/70">Insulated thermal accumulation/storage tank. Discontinued.</p>
          <a href="tel:7173890083" class="inline-block mt-6 bg-ember text-cream px-6 py-3 text-sm uppercase tracking-wide font-medium hover:bg-wood transition">Call to Order: 717-389-0083</a>
          <div class="mt-6 pt-6 border-t border-wood/10 text-sm text-charcoal/70"><span class="mr-6"><strong>SKU:</strong> 2127</span><span class="text-ember">Out of Stock</span></div>
        </div>
      </div>
    </section>
    <section class="max-w-4xl mx-auto px-6 py-12 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-6">Description</h2>
      <div class="space-y-4 text-charcoal/90 leading-relaxed">
        <h3 class="font-serif text-xl text-darkwood">Storing energy to make firewood burning more convenient</h3>
        <p>To take advantage of all the benefits of a modern, environmentally approved firewood boiler, the excess energy produced by the boiler must be stored. The Aqualux Teknik 1000 provides large-capacity thermal storage with a bivalent shunt.</p>
        <p class="text-ember">This model is discontinued.</p>
      </div>
    </section>
    <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-4">Downloads</h2>
      <div class="space-y-2">
        <a href="/images/Tekniktank_750-manual.pdf" target="_blank" class="block text-ember hover:underline">Aqualux Teknik Manual (PDF)</a>
        <a href="/images/teknik-cutaway.pdf" target="_blank" class="block text-ember hover:underline">Teknik Tank Cutaway 3D (PDF)</a>
      </div>
    </section>
    <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10"><p class="text-sm text-charcoal/60">Legacy product. Contact Smokeless Heat for availability.</p></section>
  </main>
  <Footer />
</Layout>
