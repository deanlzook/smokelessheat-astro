---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Thermal Storage | Smokeless Heat">
  <Header />
  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Products</p>
        <h1 class="font-serif text-4xl md:text-5xl">Thermal Storage</h1>
      </div>
    </section>
    <section class="py-16 bg-cream">
      <div class="max-w-4xl mx-auto px-6 space-y-4">
        <a href="/products/thermal-storage/aqualux-cu-750" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Aqualux-CU-750.jpg" alt="Aqualux CU 750" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Aqualux CU tanks</p>
            <h2 class="font-serif text-xl text-darkwood">Aqualux CU 750</h2>
            <p class="mt-1 text-charcoal/70 text-sm"><span class="line-through">$3,917.00</span> $3,329.00</p>
            <span class="text-xs uppercase tracking-wide text-ember">Out of Stock</span>
          </div>
        </a>
        <a href="/products/thermal-storage/aqualux-ub-750" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Aqualux-UB-750-1.jpg" alt="Aqualux UB 750" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Aqualux UB tanks</p>
            <h2 class="font-serif text-xl text-darkwood">Aqualux UB 750</h2>
            <p class="mt-1 text-charcoal/70 text-sm"><span class="line-through">$3,366.00</span> $2,861.00</p>
          </div>
        </a>
        <a href="/products/thermal-storage/aqualux-teknik-750" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Aqualux-Teknik-750.jpg" alt="Aqualux Teknik 750" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Aqualux Teknik Tanks</p>
            <h2 class="font-serif text-xl text-darkwood">Aqualux Teknik 750</h2>
            <p class="mt-1 text-charcoal/70 text-sm"><span class="line-through">$6,251.00</span> $5,313.00</p>
          </div>
        </a>
        <a href="/products/thermal-storage/aquaecono-ub-500" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/AquaEcono-UB-500.jpg" alt="AquaEcono UB 500" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Thermal Storage</p>
            <h2 class="font-serif text-xl text-darkwood">AquaEcono UB 500</h2>
            <p class="mt-1 text-charcoal/70 text-sm"><span class="line-through">$1,758.00</span> $1,406.00</p>
          </div>
        </a>
        <a href="/products/thermal-storage/aquaecono-cu-500" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/AquaEcono-CU-500.jpg" alt="AquaEcono CU 500" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Thermal Storage</p>
            <h2 class="font-serif text-xl text-darkwood">AquaEcono CU 500</h2>
            <p class="mt-1 text-charcoal/70 text-sm"><span class="line-through">$2,135.00</span> $1,708.00</p>
          </div>
        </a>
        <a href="/products/thermal-storage/aqualux-ub-1000" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Aqualux-UB-1000.jpg" alt="Aqualux UB 1000" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Aqualux UB tanks</p>
            <h2 class="font-serif text-xl text-darkwood">Aqualux UB 1000</h2>
            <p class="mt-1 text-charcoal/70 text-sm"><span class="line-through">$3,366.00</span> $2,861.00</p>
          </div>
        </a>
        <a href="/products/thermal-storage/aqualux-teknik-1000" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Aqualux-Teknik-750.jpg" alt="Aqualux Teknik 1000" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Aqualux Teknik Tanks</p>
            <h2 class="font-serif text-xl text-darkwood">Aqualux Teknik 1000-discontinued</h2>
            <p class="mt-1 text-charcoal/70 text-sm"><span class="line-through">$6,521.00</span> $5,313.00</p>
            <span class="text-xs uppercase tracking-wide text-ember">Out of Stock</span>
          </div>
        </a>
        <a href="/products/thermal-storage/steel-tank-asme-400" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Steel-Tank-ASME.jpg" alt="Steel Tank ASME 400" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Manchester Tank</p>
            <h2 class="font-serif text-xl text-darkwood">Steel Tank ASME 400 gallon-discontinued</h2>
            <p class="mt-1 text-charcoal/70 text-sm">$2,586.00</p>
            <span class="text-xs uppercase tracking-wide text-ember">Out of Stock</span>
          </div>
        </a>
        <a href="/products/thermal-storage/steel-tank-asme-240" class="flex bg-white border border-wood/10 hover:border-ember transition overflow-hidden">
          <img src="/images/products/Steel-Tank-ASME.jpg" alt="Steel Tank ASME 240" class="w-32 h-32 object-contain flex-shrink-0" />
          <div class="p-6">
            <p class="text-xs text-ember">Manchester Tank</p>
            <h2 class="font-serif text-xl text-darkwood">Steel Tank ASME 240 gallon</h2>
            <p class="mt-1 text-charcoal/70 text-sm">$1,799.00</p>
            <span class="text-xs uppercase tracking-wide text-ember">Out of Stock</span>
          </div>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
