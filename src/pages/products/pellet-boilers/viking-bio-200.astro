---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---
<Layout title="Viking Bio 200 | Smokeless Heat">
  <Header />
  <main class="pt-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 py-4 text-sm text-charcoal/60">
      <a href="/" class="hover:text-ember">Home</a> / <a href="/products" class="hover:text-ember">Products</a> / <a href="/products/pellet-boilers" class="hover:text-ember">Pellet Boilers</a> / <span>Viking Bio 200</span>
    </div>
    <section class="max-w-6xl mx-auto px-6 py-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <img src="/images/products/Viking-Bio-200.jpg" alt="Viking Bio 200" class="w-full max-w-sm border border-wood/10" />
        <div>
          <p class="text-sm text-ember mb-2">Viking Bio</p>
          <h1 class="font-serif text-3xl md:text-4xl text-darkwood">Viking Bio 200</h1>
          <p class="mt-2 text-charcoal/70">Self-Cleaning Pellet Burner</p>
          <a href="tel:7173890083" class="inline-block mt-6 bg-ember text-cream px-6 py-3 text-sm uppercase tracking-wide font-medium hover:bg-wood transition">Call to Order: 717-389-0083</a>
          <p class="mt-3 text-sm text-ember">Legacy – out of stock</p>
        </div>
      </div>
    </section>
    <section class="max-w-4xl mx-auto px-6 py-12 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-6">Description</h2>
      <div class="space-y-4 text-charcoal/90 leading-relaxed">
        <h3 class="font-serif text-xl text-darkwood">Self-Cleaning Pellet Burner</h3>
        <p>The Viking Bio 200 is a self-cleaning pellet burner designed for reliable operation with wood pellets. The self-cleaning feature keeps ash from building up in the burner combustion tube.</p>
        <p><strong>Key Features:</strong></p>
        <ul class="list-disc list-inside space-y-1">
          <li>Self-cleaning burner design</li>
          <li>Handles pellets with higher ash content</li>
          <li>Reliable long-term operation</li>
        </ul>
      </div>
    </section>
    <section class="max-w-4xl mx-auto px-6 py-8 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-4">Downloads</h2>
      <div class="space-y-2">
        <a href="/images/Viking_Bio_200_2014_12_08_en.pdf" target="_blank" class="block text-ember hover:underline">Viking Bio 200 Manual (PDF)</a>
        <a href="/images/VikingBio_Pellet-burner_brochure_120514.pdf" target="_blank" class="block text-ember hover:underline">Viking Bio Brochure (PDF)</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
