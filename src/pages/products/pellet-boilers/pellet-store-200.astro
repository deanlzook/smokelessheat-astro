---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---
<Layout title="Pellet Store 200 | Smokeless Heat">
  <Header />
  <main class="pt-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 py-4 text-sm text-charcoal/60">
      <a href="/" class="hover:text-ember">Home</a> / <a href="/products" class="hover:text-ember">Products</a> / <a href="/products/pellet-boilers" class="hover:text-ember">Pellet Boilers</a> / <span>Pellet Store 200</span>
    </div>
    <section class="max-w-6xl mx-auto px-6 py-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <img src="/images/products/Pellet-Store-200.jpg" alt="Pellet Store 200" class="w-full max-w-sm border border-wood/10" />
        <div>
          <p class="text-sm text-ember mb-2">Pellet Storage</p>
          <h1 class="font-serif text-3xl md:text-4xl text-darkwood">Pellet Store 200</h1>
          <p class="mt-2 text-charcoal/70">Pellet Storage Unit</p>
          <a href="tel:8553890083" class="inline-block mt-6 bg-ember text-cream px-6 py-3 text-sm uppercase tracking-wide font-medium hover:bg-wood transition">Call to Order: 855-389-0083</a>
          <p class="mt-3 text-sm text-ember">Out of stock</p>
        </div>
      </div>
    </section>
    <section class="max-w-4xl mx-auto px-6 py-12 border-t border-wood/10">
      <h2 class="font-serif text-2xl text-darkwood mb-6">Description</h2>
      <div class="space-y-4 text-charcoal/90 leading-relaxed">
        <h3 class="font-serif text-xl text-darkwood">Pellet Storage Unit</h3>
        <p>The Pellet Store 200 provides convenient storage for wood pellets, designed to work with pellet boiler systems.</p>
        <p><strong>Key Features:</strong></p>
        <ul class="list-disc list-inside space-y-1">
          <li>200 liter capacity</li>
          <li>Convenient pellet storage</li>
          <li>Designed for pellet boiler systems</li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
