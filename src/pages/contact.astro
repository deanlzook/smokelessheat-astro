---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact | Smokeless Heat" description="Contact Smokeless Heat for Vedolux wood gasification boilers, thermal storage, and dealer information. Call, email, or send a message.">
  <Header />

  <main class="pt-24">
    <!-- Hero -->
    <section class="py-20 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Get in Touch</p>
        <h1 class="font-serif text-5xl md:text-6xl">Contact Smokeless Heat</h1>
        <p class="mt-6 text-cream/70 text-lg max-w-2xl mx-auto">Questions about Vedolux boilers, thermal storage, pricing, or becoming a dealer? We’re here to help.</p>
      </div>
    </section>

    <!-- Contact Content -->
    <section class="py-20 bg-cream">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16">
          <!-- Info -->
          <div>
            <h2 class="font-serif text-3xl text-darkwood mb-8">Reach Us Directly</h2>
            
            <div class="space-y-8">
              <div>
                <p class="text-sm uppercase tracking-widest text-wood mb-2">Address</p>
                <p class="text-lg text-charcoal">
                  Smokeless Heat, LLC<br>
                  2020 Cornwall Road<br>
                  Lebanon, PA 17042
                </p>
              </div>

              <div>
                <p class="text-sm uppercase tracking-widest text-wood mb-2">Phone</p>
                <a href="tel:7173890083" class="text-lg text-charcoal hover:text-ember transition">(717) 389-0083</a>
              </div>

              <div>
                <p class="text-sm uppercase tracking-widest text-wood mb-2">Fax</p>
                <p class="text-lg text-charcoal">(717) 273-2248</p>
              </div>

              <div>
                <p class="text-sm uppercase tracking-widest text-wood mb-2">Email</p>
                <a href="mailto:info@smokelessheat.com" class="text-lg text-charcoal hover:text-ember transition">info@smokelessheat.com</a>
              </div>

              <div>
                <p class="text-sm uppercase tracking-widest text-wood mb-2">Hours</p>
                <p class="text-lg text-charcoal">
                  Monday – Friday: 9:00 AM – 5:00 PM<br>
                  Saturday – Sunday: Closed
                </p>
              </div>
            </div>

            <div class="mt-12 p-6 bg-white border border-wood/20">
              <p class="text-charcoal/70 leading-relaxed">Contact Smokeless Heat is easy. Call us at <a href="tel:7173890083" class="text-ember hover:underline">(717) 389-0083</a> or email <a href="mailto:info@smokelessheat.com" class="text-ember hover:underline">info@smokelessheat.com</a>. You can also request quotes or product information using the form.</p>
            </div>
          </div>

          <!-- Form -->
          <div>
            <h2 class="font-serif text-3xl text-darkwood mb-8">Request Information</h2>
            <form
              class="space-y-6"
              action="https://api.web3forms.com/submit"
              method="POST"
              id="contact-form"
            >
              <!-- Replace with your Web3Forms access key -->
              <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
              <!-- Honeypot spam protection -->
              <input type="checkbox" name="botcheck" style="display: none;" />
              <!-- Optional: custom subject -->
              <input type="hidden" name="subject" value="New Contact Request from Smokeless Heat Website" />

              <div>
                <label for="name" class="block text-sm uppercase tracking-widest text-wood mb-2">Name</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 bg-white border border-wood/30 focus:border-ember focus:outline-none text-charcoal">
              </div>

              <div>
                <label for="email" class="block text-sm uppercase tracking-widest text-wood mb-2">Email</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-white border border-wood/30 focus:border-ember focus:outline-none text-charcoal">
              </div>

              <div>
                <label for="phone" class="block text-sm uppercase tracking-widest text-wood mb-2">Phone</label>
                <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 bg-white border border-wood/30 focus:border-ember focus:outline-none text-charcoal">
              </div>

              <div>
                <label for="message" class="block text-sm uppercase tracking-widest text-wood mb-2">Message</label>
                <textarea id="message" name="message" rows="6" required class="w-full px-4 py-3 bg-white border border-wood/30 focus:border-ember focus:outline-none text-charcoal resize-y"></textarea>
              </div>

              <button type="submit" class="w-full bg-darkwood text-cream px-8 py-4 text-sm uppercase tracking-widest font-medium hover:bg-ember transition">
                Send Message
              </button>
            </form>
            <p class="mt-4 text-sm text-charcoal/50">Form powered by Web3Forms. Replace YOUR_ACCESS_KEY_HERE with your key from web3forms.com.</p>
          </div>
        </div>

        <!-- Map -->
        <div class="mt-20">
          <h2 class="font-serif text-3xl text-darkwood mb-6 text-center">Find Us</h2>
          <div class="aspect-video w-full max-w-5xl mx-auto overflow-hidden border border-wood/20">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3056.5!2d-76.4168!3d40.3078!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c5c0e5c5c5c5c5%3A0x0!2s2020%20Cornwall%20Rd%2C%20Lebanon%2C%20PA%2017042!5e0!3m2!1sen!2sus!4v1732000000000!5m2!1sen!2sus"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Smokeless Heat location map"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
