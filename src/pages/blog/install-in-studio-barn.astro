---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Install in Studio Barn | Smokeless Heat Blog" description="This Install in Studio Barn was in a studio barn in New Hampshire. The heat distribution is radiant.">
  <Header />

  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Installation</p>
        <h1 class="font-serif text-4xl md:text-5xl">Install in Studio Barn</h1>
      </div>
    </section>

    <article class="py-16 bg-cream">
      <div class="max-w-3xl mx-auto px-6 space-y-8 text-charcoal/90 leading-relaxed">
        <p>
          This Install in Studio Barn was in a studio barn in New Hampshire. The heat distribution is radiant.
        </p>

        <div class="space-y-6">
          <img src="https://smokelessheat.com/wp-content/uploads/2015/03/NH_studiobarn.png" alt="Studio barn in New Hampshire" class="w-full border border-wood/20" />
          <img src="https://smokelessheat.com/wp-content/uploads/2015/03/NH_Vedolux_tanks1.png" alt="Vedolux and tanks" class="w-full border border-wood/20" />
          <img src="https://smokelessheat.com/wp-content/uploads/2015/03/NH_upperheader-300x225-1.png" alt="Upper header" class="w-full border border-wood/20" />
          <img src="https://smokelessheat.com/wp-content/uploads/2015/03/NH_boiler_tankconnection-300x225-1.png" alt="Boiler tank connection" class="w-full border border-wood/20" />
          <img src="https://smokelessheat.com/wp-content/uploads/2015/03/NH_radiant_zones-225x300-1.png" alt="Radiant zones" class="w-full border border-wood/20" />
        </div>

        <p class="text-sm text-wood mt-12 pt-6 border-t border-wood/20">
          Originally published: March 2015
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
