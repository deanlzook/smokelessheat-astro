---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Install in Studio Barn | Smokeless Heat Blog" description="Installation of a Vedolux system in a studio barn.">
  <Header />

  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Installation</p>
        <h1 class="font-serif text-4xl md:text-5xl">Install in Studio Barn</h1>
      </div>
    </section>

    <article class="py-16 bg-cream">
      <div class="max-w-3xl mx-auto px-6 space-y-6 text-charcoal/90 leading-relaxed">
        <p>
          Original post content and photos from smokelessheat.com/install-in-studio-barn/ will be added here. The live site currently has a security check that prevents automatic extraction of the full text and images.
        </p>
        <p>
          Please share screenshots of the original post or paste the text if you would like it matched exactly, including all photos.
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
