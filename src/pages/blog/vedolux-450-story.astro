---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Vedolux 450 Story | Smokeless Heat Blog" description="Follow this post link on firewoodhoardersclub.com featuring a Vedolux 450.">
  <Header />

  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Installation</p>
        <h1 class="font-serif text-4xl md:text-5xl">Vedolux 450 Story</h1>
      </div>
    </section>

    <article class="py-16 bg-cream">
      <div class="max-w-3xl mx-auto px-6 space-y-6 text-charcoal/90 leading-relaxed">
        <p>
          Follow this post link on <a href="https://firewoodhoardersclub.com/forums/threads/vedolux-lambda-450.39919/" class="text-ember hover:underline">firewoodhoardersclub.com</a> featuring a Vedolux 450.
        </p>

        <div class="mt-12 aspect-video w-full">
          <iframe 
            width="100%" 
            height="100%" 
            src="https://www.youtube.com/embed/pog8L-6xOm8" 
            title="Vedolux 450 Story" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            class="rounded border border-wood/20"
          ></iframe>
        </div>

        <p class="text-sm text-wood mt-12 pt-6 border-t border-wood/20">
          Originally published: 2022
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
