---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Vedolux 650 Lambda Controlled Wood Boiler | Smokeless Heat Blog" description="This is a 4 minute video of a Vedolux 650 Lambda controlled wood boiler.">
  <Header />

  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Operation</p>
        <h1 class="font-serif text-4xl md:text-5xl">Vedolux 650 Lambda Controlled Wood Boiler</h1>
      </div>
    </section>

    <article class="py-16 bg-cream">
      <div class="max-w-3xl mx-auto px-6 space-y-6 text-charcoal/90 leading-relaxed">
        <p>
          This is a 4-minute video of a Vedolux 650 Lambda controlled wood boiler. It shows the boiler under fire, some information that is available from the controller screen, and some interior views. Enjoy!
        </p>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="aspect-video w-full">
            <iframe 
              width="100%" 
              height="100%" 
              src="https://www.youtube.com/embed/zpE4rqylOPY" 
              title="Vedolux 650 video 1" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
              class="rounded border border-wood/20"
            ></iframe>
          </div>
          <div class="aspect-video w-full">
            <iframe 
              width="100%" 
              height="100%" 
              src="https://www.youtube.com/embed/1qG62ewjmdw" 
              title="Vedolux 650 video 2" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
              class="rounded border border-wood/20"
            ></iframe>
          </div>
        </div>

        <p class="text-sm text-wood mt-12 pt-6 border-t border-wood/20">
          Originally published: 2022
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
