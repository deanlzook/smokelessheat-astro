---

<Layout title="Blog | Smokeless Heat" description="Articles and guides about wood gasification boilers, Vedolux, thermal storage, and clean wood heating.">
  <Header />

  <main class="pt-24">
    <section class="py-20 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Insights</p>
        <h1 class="font-serif text-5xl md:text-6xl">Blog</h1>
      </div>
    </section>

    <section class="py-20 bg-cream">
      <div class="max-w-4xl mx-auto px-6">
        <div class="space-y-12">
          {posts.map(post => (
            <article class="border-b border-wood/20 pb-12 flex flex-col md:flex-row gap-6">
              {post.thumbnail && (
                <div class="md:w-40 flex-shrink-0">
                  <img src={post.thumbnail} alt={post.title} class="w-full aspect-square object-contain bg-white border border-wood/20" />
                </div>
              )}
              <div class="flex-1">
                <p class="text-sm uppercase tracking-widest text-wood mb-2">{post.date}</p>
                <h2 class="font-serif text-3xl text-darkwood mb-4">
                  <a href={`/blog/${post.slug}`} class="hover:text-ember transition">{post.title}</a>
                </h2>
                <p class="text-charcoal/80 leading-relaxed mb-6">{post.excerpt}</p>
                <a href={`/blog/${post.slug}`} class="text-ember text-sm uppercase tracking-widest font-medium hover:underline">Read More</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
