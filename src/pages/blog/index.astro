---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: 'epa-nsps',
    title: 'EPA NSPS and Vedolux Wood Boilers',
    date: 'News',
    excerpt: 'Please take a look at our newer posting for an update on where we stand regarding the EPA testing. All the current for sale boilers are EPA certified models.',
  },
  {
    slug: 'lighting-a-vedolux37',
    title: 'Lighting a Vedolux 37',
    date: 'Operation',
    excerpt: 'This YouTube video shows a Vedolux 37 owner lighting the boiler and demonstrates a fast startup method.',
  },
  {
    slug: 'ag-progress-show-2013',
    title: 'Ag Progress Show 2013',
    date: 'Events',
    excerpt: 'This Ag Progress show 2013 was very well attended. We were displaying the Vedolux boilers in our new operational trailer.',
  },
  {
    slug: 'install-in-studio-barn',
    title: 'Install in Studio Barn',
    date: 'Installation',
    excerpt: 'Installation of a Vedolux system in a studio barn.',
  },
  {
    slug: 'vedolux-50-with-storage-tanks',
    title: 'Vedolux 50 with Storage Tanks',
    date: 'Installation',
    excerpt: 'How the Vedolux 50 wood gasification boiler pairs with thermal storage tanks for efficient batch burning and convenient heating.',
  },
  {
    slug: 'variable-speed-circulators',
    title: 'Variable Speed Circulators',
    date: 'Blog',
    excerpt: 'How variable speed circulators improve efficiency, comfort, and stratification in wood boiler and thermal storage systems.',
  },
  {
    slug: 'what-is-wood-gasification',
    title: 'What is Wood Gasification',
    date: 'January 17, 2009',
    excerpt: 'Wood gasification is a way of burning wood so cleanly that the chimney produces almost no smoke. Learn how Vedolux boilers use this process.',
  },
];
---

<Layout title="Blog | Smokeless Heat" description="Articles and guides about wood gasification boilers, Vedolux, thermal storage, and clean wood heating.">
  <Header />

  <main class="pt-24">
    <section class="py-20 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Insights</p>
        <h1 class="font-serif text-5xl md:text-6xl">Blog</h1>
      </div>
    </section>

    <section class="py-20 bg-cream">
      <div class="max-w-4xl mx-auto px-6">
        <div class="space-y-12">
          {posts.map(post => (
            <article class="border-b border-wood/20 pb-12">
              <p class="text-sm uppercase tracking-widest text-wood mb-2">{post.date}</p>
              <h2 class="font-serif text-3xl text-darkwood mb-4">
                <a href={`/blog/${post.slug}`} class="hover:text-ember transition">{post.title}</a>
              </h2>
              <p class="text-charcoal/80 leading-relaxed mb-6">{post.excerpt}</p>
              <a href={`/blog/${post.slug}`} class="text-ember text-sm uppercase tracking-widest font-medium hover:underline">Read More</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
