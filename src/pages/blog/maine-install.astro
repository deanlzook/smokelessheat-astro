---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Maine Install | Smokeless Heat Blog" description="Pictures of an install of a Vedolux 30 boiler installation in Maine.">
  <Header />

  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Installation</p>
        <h1 class="font-serif text-4xl md:text-5xl">Maine Install</h1>
      </div>
    </section>

    <article class="py-16 bg-cream">
      <div class="max-w-3xl mx-auto px-6 space-y-8 text-charcoal/90 leading-relaxed">
        <p>
          Pictures of an install of a Vedolux 30 boiler installation in Maine.
        </p>

        <div class="space-y-6">
          <div>
            <img src="/images/maine-vedolux30-400x400.png" alt="Vedolux 30 and Aqualux accumulator tanks with 9KW electric backup" class="w-full border border-wood/20" />
            <p class="text-sm text-center mt-2 text-wood">Vedolux 30 and Aqualux accumulator tanks with 9KW electric backup</p>
          </div>

          <div>
            <img src="/images/maine-aqualuxCU-domestic-300x199-1.png" alt="Domestic water connection to Aqualux CU tank" class="w-full border border-wood/20" />
            <p class="text-sm text-center mt-2 text-wood">Domestic water connection to Aqualux CU tank</p>
          </div>

          <div>
            <img src="/images/Maine-aqualux-connections-300x199-1.png" alt="Aqualux CU heating load connection to 4 way mixing valve" class="w-full border border-wood/20" />
            <p class="text-sm text-center mt-2 text-wood">Aqualux CU heating load connection to 4 way mixing valve</p>
          </div>

          <div>
            <img src="/images/Maine-taco-zoneControl-300x199-1.png" alt="Taco zone control" class="w-full border border-wood/20" />
            <p class="text-sm text-center mt-2 text-wood">Taco zone control</p>
          </div>

          <div>
            <img src="/images/Maine-aqualux-with-9kw-element-300x199-1.png" alt="Loading valve and 9KW backup element" class="w-full border border-wood/20" />
            <p class="text-sm text-center mt-2 text-wood">Loading valve and 9KW backup element</p>
          </div>
        </div>

        <p class="text-sm text-wood mt-12 pt-6 border-t border-wood/20">
          Originally published: March 2015
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
