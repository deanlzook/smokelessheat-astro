---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CATEGORIES } from '../lib/categories';
import { getProducts } from '../lib/products';

// Category cards; a category is listed once it has at least one product
// in the `products` collection.
const products = await getProducts();
const categories = CATEGORIES.filter((c) => products.some((p) => p.data.category === c.slug));
---

<Layout title="Products | Smokeless Heat" description="Vedolux wood gasification boilers, thermal storage tanks, and heating accessories.">
  <Header />

  <main class="pt-24">
    <section class="py-16 bg-charcoal text-cream">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-ember text-sm uppercase tracking-[0.3em] mb-4">Our Products</p>
        <h1 class="font-serif text-4xl md:text-5xl">Products</h1>
        <p class="mt-4 text-cream/70 max-w-2xl">High-efficiency Vedolux wood gasification boilers, thermal storage systems, and supporting heating accessories.</p>
      </div>
    </section>

    <section class="py-20 bg-cream">
      <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-3 gap-8">
        {categories.map((category) => (
          <a href={`/products/${category.slug}`} class="group block bg-white border border-wood/10 p-8 hover:border-ember transition">
            <h2 class="font-serif text-2xl text-darkwood group-hover:text-ember transition">{category.title}</h2>
            <p class="mt-3 text-charcoal/70">{category.description}</p>
            <span class="inline-block mt-6 text-sm uppercase tracking-widest text-ember">{category.cta} →</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>