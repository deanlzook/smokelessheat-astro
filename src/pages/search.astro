---
<Layout title="Search | Smokeless Heat">
  <Header />
  <main class="pt-28 pb-16">
    <section class="max-w-3xl mx-auto px-6 py-12">
      <h1 class="font-serif text-3xl text-darkwood mb-6">Search</h1>
      <input id="search-input" type="text" placeholder="Search products, blog posts, pages..." class="w-full border border-wood/20 px-4 py-3 text-lg focus:outline-none focus:border-ember" />
      <div id="results" class="mt-6 space-y-2"></div>
    </section>
  </main>
  <Footer />
  <script define:vars={{ items }}>
    const input = document.getElementById('search-input');
    const results = document.getElementById('results');
    const data = items;
    function render(q) {
      const query = q.toLowerCase().trim();
      if (!query) { results.innerHTML = ''; return; }
      const matches = data.filter(i => 
        i.title.toLowerCase().includes(query) || 
        (i.text && i.text.toLowerCase().includes(query))
      );
      if (matches.length === 0) {
        results.innerHTML = '<p class="text-charcoal/60">No results found.</p>';
        return;
      }
      results.innerHTML = matches.map(i => `
        <a href="${i.href}" class="block p-4 bg-white border border-wood/10 hover:border-ember">
          <span class="text-xs text-ember">${i.type}</span><br>
          <span class="font-serif text-lg text-darkwood">${i.title}</span>
        </a>
      `).join('');
    }
    input.addEventListener('input', e => render(e.target.value));
    const params = new URLSearchParams(window.location.search);
    if (params.get('q')) { input.value = params.get('q'); render(params.get('q')); }
  </script>
</Layout>
