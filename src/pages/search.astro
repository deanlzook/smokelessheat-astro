---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Static list of searchable content
const items = [
  { title: "Vedolux Lambda 350", href: "/products/wood-boilers/vedolux-lambda-350", type: "Product" },
  { title: "Vedolux Lambda 450", href: "/products/wood-boilers/vedolux-lambda-450", type: "Product" },
  { title: "Vedolux Lambda 650", href: "/products/wood-boilers/vedolux-lambda-650", type: "Product" },
  { title: "Vedolux 55", href: "/products/wood-boilers/vedolux-55", type: "Product" },
  { title: "Vedolux 37", href: "/products/wood-boilers/vedolux-37", type: "Product" },
  { title: "Vedolux 30", href: "/products/wood-boilers/vedolux-30", type: "Product" },
  { title: "Vedolux 40 UB", href: "/products/wood-boilers/vedolux-40-ub", type: "Product" },
  { title: "Vedolux 50 UB", href: "/products/wood-boilers/vedolux-50-ub", type: "Product" },
  { title: "9 kW Immersion Heater", href: "/products/heating-accessories/9kw-immersion-heater", type: "Product" },
  { title: "How It Works", href: "/how-it-works", type: "Page" },
  { title: "About", href: "/about", type: "Page" },
  { title: "Contact", href: "/contact", type: "Page" },
  { title: "Blog", href: "/blog", type: "Page" },
  { title: "Links", href: "/links", type: "Page" },
  { title: "Wood Boilers", href: "/products/wood-boilers", type: "Category" },
  { title: "Thermal Storage", href: "/products/thermal-storage", type: "Category" },
  { title: "Heating Accessories", href: "/products/heating-accessories", type: "Category" },
];
---
<Layout title="Search | Smokeless Heat">
  <Header />
  <main class="pt-28 pb-16">
    <section class="max-w-3xl mx-auto px-6 py-12">
      <h1 class="font-serif text-3xl text-darkwood mb-6">Search</h1>
      <input id="search-input" type="text" placeholder="Search products, pages..." class="w-full border border-wood/20 px-4 py-3 text-lg focus:outline-none focus:border-ember" />
      <div id="results" class="mt-6 space-y-2"></div>
    </section>
  </main>
  <Footer />
  <script define:vars={{ items }}>
    const input = document.getElementById('search-input');
    const results = document.getElementById('results');
    const data = items;
    function render(q) {
      const query = q.toLowerCase().trim();
      if (!query) { results.innerHTML = ''; return; }
      const matches = data.filter(i => i.title.toLowerCase().includes(query));
      if (matches.length === 0) {
        results.innerHTML = '<p class="text-charcoal/60">No results found.</p>';
        return;
      }
      results.innerHTML = matches.map(i => `<a href="${i.href}" class="block p-4 bg-white border border-wood/10 hover:border-ember"><span class="text-xs text-ember">${i.type}</span><br><span class="font-serif text-lg text-darkwood">${i.title}</span></a>`).join('');
    }
    input.addEventListener('input', e => render(e.target.value));
    // Check URL params
    const params = new URLSearchParams(window.location.search);
    if (params.get('q')) { input.value = params.get('q'); render(params.get('q')); }
  </script>
</Layout>
