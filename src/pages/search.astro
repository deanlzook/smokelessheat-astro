---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Search | Smokeless Heat" description="Search Smokeless Heat products, blog posts, and pages.">
  <Header />
  <main class="pt-28 pb-16">
    <section class="max-w-3xl mx-auto px-6 py-12">
      <h1 class="font-serif text-3xl text-darkwood mb-2">Search</h1>
      <p class="text-charcoal/70 mb-6">Look up products, blog posts, and pages by keyword.</p>
      <input
        id="search-input"
        type="text"
        placeholder="Search products, blog posts, pages..."
        autocomplete="off"
        class="w-full border border-wood/20 px-4 py-3 text-lg focus:outline-none focus:border-ember bg-white"
      />
      <div id="results" class="mt-6 space-y-2"></div>
    </section>
  </main>
  <Footer />
  <script>
    import { search, highlight, escapeHtml, type SearchItem } from '../lib/search';

    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const results = document.getElementById('results');
    let items: SearchItem[] | null = null;
    let loadError = false;

    async function loadIndex(): Promise<SearchItem[]> {
      if (items) return items;
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error('Failed to load search index');
      items = await res.json();
      return items;
    }

    function render(q: string) {
      if (!input || !results) return;
      const query = q.trim();
      if (!query) {
        results.innerHTML = '';
        return;
      }
      if (loadError) {
        results.innerHTML = '<p class="text-charcoal/60">Search is unavailable right now. Please try again.</p>';
        return;
      }
      if (!items) {
        results.innerHTML = '<p class="text-charcoal/60">Searching…</p>';
        return;
      }
      const hits = search(items, query);
      if (hits.length === 0) {
        results.innerHTML = '<p class="text-charcoal/60">No results found.</p>';
        return;
      }
      const words = query.toLowerCase().match(/[a-z0-9]+(?:\.[0-9]+)*/g) ?? [];
      results.innerHTML = hits.map((hit) => {
        const title = highlight(hit.item.title, words);
        const snippet = hit.snippet ? highlight(hit.snippet, words) : '';
        return `
          <a href="${escapeHtml(hit.item.href)}" class="block p-4 bg-white border border-wood/10 hover:border-ember">
            <span class="text-xs text-ember">${escapeHtml(hit.item.type)}</span><br>
            <span class="font-serif text-lg text-darkwood">${title}</span>
            ${snippet ? `<p class="mt-1 text-sm text-charcoal/80 leading-relaxed">${snippet}</p>` : ''}
          </a>`;
      }).join('');
    }

    async function onQuery(q: string, pushUrl: boolean) {
      render(q);
      if (pushUrl) {
        const url = q.trim() ? `/search?q=${encodeURIComponent(q.trim())}` : '/search';
        history.replaceState(null, '', url);
      }
      if (!items && !loadError) {
        try {
          await loadIndex();
          render(q);
        } catch {
          loadError = true;
          render(q);
        }
      }
    }

    if (input && results) {
      input.addEventListener('input', (e) => onQuery((e.target as HTMLInputElement).value, true));
      const params = new URLSearchParams(window.location.search);
      const initial = params.get('q') || '';
      if (initial) input.value = initial;
      onQuery(initial, false);
    }
  </script>
</Layout>
